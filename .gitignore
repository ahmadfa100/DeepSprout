# Operating-system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor backups, merge leftovers and Office lock files
*.swp
*~
*.orig
*.rej
~$*

# Local credentials, keys and machine-specific tool permissions
.env
.env.*
!.env.example
.claude/settings.local.json
src/DeepSprout.Web/.keys/
*.pfx
*.p12

# .NET build output and local tooling
**/bin/
**/obj/
.dotnet/
.nuget/
.tools/
*.binlog
TestResults/
coverage/
*.coverage
*.coveragexml

# IDE local state (Visual Studio, Rider); .vscode/settings.json is shared and tracked
.vs/
.idea/
*.suo
*.user
*.DotSettings.user

# Node.js dependencies and caches
node_modules/
.npm/
.eslintcache
npm-debug.log*

# Python bytecode, caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Playwright local output (curated screenshots under docs/ stay tracked)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs, dumps, caches and disposable local outputs
*.log
*.dmp
*.stackdump
*.tmp
*.temp
.cache/
validation-results.jsonl
validation-errors.txt
artifacts/
.tmp/

# Local database files and backups
*.sqlite
*.mdf
*.ldf
*.bak
*.bacpac
