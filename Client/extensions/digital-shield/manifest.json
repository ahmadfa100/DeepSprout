{
  "manifest_version": 3,
  "name": "DeepSprout Digital Shield — Local Demo",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Optional whole-site protection and one shared active-site usage reminder. Browser-local demonstration.",
  "permissions": ["storage", "alarms", "idle", "declarativeNetRequest"],
  "host_permissions": ["*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "DeepSprout Shield"},
  "incognito": "not_allowed",
  "content_scripts": [{
    "matches": ["http://127.0.0.1/src/pages/member/*", "http://localhost/src/pages/member/*"],
    "js": ["bridge.js"], "run_at": "document_start", "all_frames": false
  }, {
    "matches": ["*://*.instagram.com/*", "*://*.youtube.com/*", "*://*.tiktok.com/*"],
    "js": ["observer.js"], "run_at": "document_idle", "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
