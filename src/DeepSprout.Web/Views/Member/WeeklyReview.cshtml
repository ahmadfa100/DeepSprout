  <script src="../../../../src/js/data/account.js" defer></script>
  <script src="../../../../src/layouts/member-layout/member-layout.js" defer></script>
  <script src="weekly-review.js" defer></script>
</head>
<body data-page="recovery" data-root="../../../../">
  <a class="wr-skip-link" href="#wr-main">Skip to main content</a>
  <svg class="icon-defs" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></symbol>
    <symbol id="i-minus" viewBox="0 0 24 24"><path d="M6 12h12"/></symbol>
    <symbol id="i-question" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2-2.4 3.4m0 2.9v.3"/></symbol>
    <symbol id="i-walk" viewBox="0 0 32 32"><circle cx="18" cy="5" r="2"/><path d="m13 28 3-9-4-4-4 5m4-5 4-5 5 1 3 5m-8 3 7 3 2 7m-9-10-6 9"/></symbol>
    <symbol id="i-book" viewBox="0 0 32 32"><path d="M16 7c-4-3-9-3-13-2v19c5-1 10 0 13 3 3-3 8-4 13-3V5c-4-1-9-1-13 2Zm0 0v20"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 2.8 20 6v6c0 5-3.4 8.4-8 9.2C7.4 20.4 4 17 4 12V6l8-3.2Z"/><path d="m8.6 12 2.4 2.4 4.4-4.6"/></symbol>
    <symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></symbol>
    <symbol id="i-clipboard" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="18" rx="2"/><path d="M9 4.5h6V2H9v2.5Zm-1 8 2 2 4-4m-6 8h8"/></symbol>
    <symbol id="i-flask" viewBox="0 0 24 24"><path d="M9 2h6m-5 0v7L4.7 18a2 2 0 0 0 1.7 3h11.2a2 2 0 0 0 1.7-3L14 9V2M8 16h8"/></symbol>
    <symbol id="i-monitor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8m-4-4v4"/></symbol>
    <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></symbol>
    <symbol id="i-sprout" viewBox="0 0 24 24"><path d="M12 21V10m0 3C7 13 5 10 5 6c5 0 7 2 7 7Zm0-2c0-4 2-6 7-6 0 4-2 6-7 6Z"/></symbol>
    <symbol id="i-cycle" viewBox="0 0 24 24"><path d="M20 8a8 8 0 0 0-14-3L4 7m0-4v4h4m-4 9a8 8 0 0 0 14 3l2-2m0 4v-4h-4"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="i-levels" viewBox="0 0 24 24"><path d="M4 20v-5m5 5V9m5 11V4m5 16v-9"/></symbol>
    <symbol id="i-headphones" viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 13h3v7H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 1-2Zm16 0h-3v7h2a2 2 0 0 0 2-2v-3a2 2 0 0 0-1-2Z"/></symbol>
    <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M20 4C10 4 4 7 4 15a5 5 0 0 0 5 5c8 0 11-6 11-16ZM4 20c4-6 7-8 12-11"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 2 2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2Z"/></symbol>
  </svg>

  <div data-site-header></div>

  <main class="wr" id="wr-main">

    <!-- ------------------------------------------------------- no review due -->
    <section class="wr-stage" data-stage="none" hidden aria-labelledby="none-title">
      <div class="narrow-shell wr-none">
        <span class="badge-icon wr-none-mark"><svg><use href="#i-calendar"/></svg></span>
        <h1 id="none-title">No review is due yet.</h1>
        <p class="wr-lead" id="none-text"></p>
        <div class="btn-row wr-none-actions">
          <a class="btn btn-primary" href="../recovery-plan/recovery-plan.html">Open my plan <svg><use href="#i-arrow"/></svg></a>
          <a class="btn btn-ghost" href="../../../../index.html">Back to home</a>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- the review -->
    <section class="wr-stage" data-stage="review" hidden aria-labelledby="review-title">
      <div class="page-shell wr-review">
        <header class="wr-head">
          <p class="eyebrow" id="review-eyebrow">Week 1 review</p>
          <h1 id="review-title">How did this week go?</h1>
          <p class="wr-lead">This is a short decision point, not a fifth assessment. Two questions, then you choose what next week looks like.</p>
        </header>

        <div class="wr-grid">
          <div class="wr-main">

            <section class="card wr-evidence-card" aria-labelledby="happened-title">
              <div class="card-head">
                <span class="badge-icon"><svg><use href="#i-check"/></svg></span>
                <div><p class="eyebrow">Step 1 · what happened</p><h2 id="happened-title">The week as recorded</h2></div>
              </div>
              <div class="wr-ledger" id="ledger"></div>
              <details class="wr-source-details"><summary>Other evidence from this week</summary><div id="supporting-evidence"></div></details>
            </section>

            <section class="card" aria-labelledby="q1-title">
              <div class="card-head">
                <span class="badge-icon gold"><svg><use href="#i-question"/></svg></span>
                <div><p class="eyebrow">Step 2 · two questions</p><h2 id="q1-title">How manageable did this plan feel?</h2></div>
              </div>
              <div class="choice-grid wr-answers" id="q1" role="radiogroup" aria-labelledby="q1-title"></div>

              <h3 class="wr-subquestion" id="q2-title">Did this week's activity choices fit you?</h3>
              <div class="choice-grid wr-answers" id="q2" role="radiogroup" aria-labelledby="q2-title"></div>
              <p class="wr-question-note"><strong>Help shape your next week.</strong> Your answers help us suggest a pace and activity choices that better fit you.</p>
            </section>

            <section class="card" aria-labelledby="next-title">
              <div class="card-head">
                <span class="badge-icon sky"><svg><use href="#i-compass"/></svg></span>
                <div><p class="eyebrow">Step 3 · next week</p><h2 id="next-title">What we'd suggest</h2></div>
              </div>
              <div class="wr-recommendation" id="recommendation">
                <p class="wr-rec-text" id="rec-text" aria-live="polite">Answer the two questions above and a suggestion appears here, with the reason behind it.</p>
                <ul class="wr-rec-why" id="rec-why"></ul>
              </div>
              <div class="wr-options" id="outcome-options" role="radiogroup" aria-label="Choose how to set next week"></div>
              <div id="review-adjustment" hidden><label>Practice days<select id="review-days"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></label><label>Time preference<select id="review-minutes"><option>5</option><option>10</option><option>15</option></select> minutes</label><label>Preferred type<select id="review-mix"><option value="depth">Depth Practice</option><option value="listening">Listening &amp; Recall</option><option value="practical">Practical Micro-Challenge</option><option value="protected-work">Protected Work</option></select></label></div>
              <div class="wr-timeline-heading"><span class="badge-icon"><svg><use href="#i-calendar"/></svg></span><div><h3>Future schedule preview</h3><p>Here’s what your proposed next week could look like.</p></div></div>
              <ol id="next-week-preview" class="wr-timeline" aria-label="Proposed next week by day"></ol>
              <p class="card-note">Nothing increases on its own. Whatever you pick is saved as a plan revision with the reason, and your history is kept either way.</p>
            </section>
          </div>

          <aside class="wr-aside">
            <div class="card wr-summary">
              <div class="wr-summary-head"><span class="badge-icon"><svg><use href="#i-sprout"/></svg></span><h2>This cycle</h2></div>
              <dl id="cycle-summary"></dl>
              <button class="btn btn-primary wr-save" type="button" id="save-review" disabled>Save my review <svg><use href="#i-arrow"/></svg></button>
              <p class="wr-save-note" id="save-note">Answer both questions to continue.</p>
              <a class="btn btn-quiet wr-skip" href="../../../../index.html">Skip for now</a>
              <p class="wr-skip-note">If you return after skipping, a conservative current week can continue. The skipped review stays uncompleted, and no missed backlog is added.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- saved -->
    <section class="wr-stage" data-stage="saved" hidden aria-labelledby="saved-title">
      <div class="narrow-shell wr-saved">
        <span class="badge-icon wr-saved-mark"><svg><use href="#i-check"/></svg></span>
        <p class="eyebrow">Review saved</p>
        <h1 id="saved-title">Next week is set.</h1>
        <p class="wr-lead" id="saved-text"></p>
        <div class="card wr-revision">
          <p class="eyebrow">Recorded as a plan revision</p>
          <dl id="revision-summary"></dl>
          <p class="card-note">This revision applies to future days only. Nothing already recorded was changed.</p>
        </div>
        <div class="btn-row wr-saved-actions">
          <a class="btn btn-primary" href="../recovery-plan/recovery-plan.html">Open my plan <svg><use href="#i-arrow"/></svg></a>
          <a class="btn btn-ghost" href="../../../../index.html">Back to home</a>
        </div>
      </div>
    </section>
  </main>

  <div data-site-footer></div>
</body>
</html>
