  <div data-site-header></div>

  <main class="ins" id="insights" aria-busy="true">

    <header class="ins-hero" aria-labelledby="ins-title">
      <div class="ins-hero-copy">
        <p class="ins-eyebrow">Insights</p>
        <h1 id="ins-title">See what’s changing.</h1>
        <p class="ins-hero-description">A clear view of your digital habits, practice progress, and assessment results — with the evidence behind them.</p>
      </div>
      <p class="ins-snapshot" id="ins-snapshot"><svg aria-hidden="true"><use href="#i-calendar"/></svg><span>Loading snapshot…</span></p>
    </header>

    <p class="ins-error" id="ins-error" role="alert" hidden></p>

    <nav class="ins-section-nav" aria-label="Insights sections">
      <a href="#glance" aria-current="location"><svg aria-hidden="true"><use href="#i-grid"/></svg>Overview</a>
      <a href="#usage"><svg aria-hidden="true"><use href="#i-monitor"/></svg>Digital Habits</a>
      <a href="#adherence"><svg aria-hidden="true"><use href="#i-layers"/></svg>Plan &amp; Practice</a>
      <a href="#checkins"><svg aria-hidden="true"><use href="#i-chart"/></svg>Assessments</a>
      <a href="#beyond"><svg aria-hidden="true"><use href="#i-sprout"/></svg>Offline Life</a>
    </nav>

    <section class="ins-section ins-glance" id="glance" aria-labelledby="glance-title">
      <div class="ins-glance-intro"><h2 id="glance-title">At a glance</h2><p>Your progress this week and what the data shows so far.</p><span class="ins-botanical" aria-hidden="true"><svg><use href="#i-sprout"/></svg></span></div>
      <div class="ins-glance-grid" id="glance-grid"></div>
    </section>

    <section class="ins-section ins-story" id="usage" aria-labelledby="usage-title">
      <div class="ins-story-rail"><span class="ins-story-icon"><svg aria-hidden="true"><use href="#i-monitor"/></svg></span><div><h2 id="usage-title">Digital Habits</h2><p>Your time on distracting content and overall screen use.</p></div></div>
      <div class="ins-story-content ins-digital-layout">
        <div class="ins-digital-browser">
          <div class="ins-inline-heading"><h3>Time on the sites you chose</h3><span class="ins-head-meta" id="usage-meta"></span></div>
          <div class="ins-browser-controls"><div class="ins-period" role="group" aria-label="Period for browser data"><span class="ins-period-thumb" aria-hidden="true"></span><button type="button" data-period="7" aria-pressed="false">7 days</button><button type="button" data-period="14" aria-pressed="true">14 days</button><button type="button" data-period="28" aria-pressed="false">28 days</button></div><p class="ins-coverage" id="ins-coverage" aria-live="polite"><span class="ins-skeleton">Loading your data…</span></p></div>
          <div id="usage-body"></div>
        </div>
        <aside class="ins-phone" id="phone-box" aria-label="Phone screen time" hidden></aside>
      </div>
    </section>

    <section class="ins-section ins-story" id="adherence" aria-labelledby="adherence-title">
      <div class="ins-story-rail"><span class="ins-story-icon"><svg aria-hidden="true"><use href="#i-layers"/></svg></span><div><h2 id="adherence-title">Plan &amp; Practice</h2><p>Your consistency in following the plan and progress in each practice type.</p></div></div>
      <div class="ins-story-content">
        <div class="ins-inline-heading"><h3>This week’s adherence</h3><span class="ins-head-meta" id="adherence-meta"></span></div>
        <div id="adherence-body"></div>
        <div class="ins-practice-divider"></div>
        <div class="ins-inline-heading"><h3 id="training-title">Practice progress by type</h3><span class="ins-head-meta" id="training-meta"></span></div>
        <div id="training"><div class="ins-training-grid" id="training-body"></div><p class="ins-footnote" id="training-note"></p></div>
      </div>
    </section>

    <section class="ins-section ins-story" id="checkins" aria-labelledby="checkins-title">
      <div class="ins-story-rail"><span class="ins-story-icon"><svg aria-hidden="true"><use href="#i-chart"/></svg></span><div><h2 id="checkins-title">Assessments</h2><p>Cognitive and habit measures completed in the Lab.</p></div></div>
      <div class="ins-story-content ins-assessment-layout">
        <div class="ins-assessment-results"><div class="ins-inline-heading"><div><h3>Your results</h3><p id="checkins-eyebrow"></p></div><span class="ins-head-meta" id="checkins-meta"></span></div><div class="ins-ranges" id="checkins-body"></div><p class="ins-caveat"><svg aria-hidden="true"><use href="#i-info"/></svg><span>These are task results, not a diagnosis. An earlier test version may not support a reliable comparison.</span></p></div>
        <aside class="ins-assessment-window" id="checkins-window"></aside>
      </div>
    </section>

    <section class="ins-section ins-story" id="beyond" aria-labelledby="beyond-title">
      <div class="ins-story-rail"><span class="ins-story-icon"><svg aria-hidden="true"><use href="#i-sprout"/></svg></span><div><h2 id="beyond-title">Offline Life</h2><p>Your real-world activities beyond the screen.</p></div></div>
      <div class="ins-story-content"><div class="ins-beyond-grid" id="beyond-body"></div></div>
    </section>

    <section class="ins-section ins-story ins-next" id="next" aria-labelledby="next-title">
      <div class="ins-story-rail"><span class="ins-story-icon"><svg aria-hidden="true"><use href="#i-sprout"/></svg></span><div><h2 id="next-title">Next Steps</h2><p>Recommended actions based on your current data.</p></div></div>
      <div class="ins-story-content"><ol class="ins-steps" id="next-body"></ol></div>
    </section>

    <div class="ins-tooltip" id="ins-tooltip" role="tooltip" hidden></div>
  </main>

  <div data-site-footer></div>
</body>
</html>
