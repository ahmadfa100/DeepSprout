<!doctype html>
<html lang="en" style="background:#fbf6ea">
<head>
  <link rel="icon" type="image/png" href="../../../../assets/brand/logo.png">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbf6ea">
  <meta name="view-transition" content="same-origin">
  <meta name="description" content="Meet Bimo and set up DeepSprout with six short questions.">
  <title>Welcome — DeepSprout</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600;9..40,700&family=Kalam:wght@@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="quick-setup.css">
  <style>@@view-transition{navigation:auto}</style>
  <script src="../../../js/data/personal-access.js" defer></script>
  <script src="../../../../src/js/utils/storage.js" defer></script>
  <script src="../../../../src/js/data/account.js" defer></script>
  <script src="quick-setup.js" defer></script>
</head>
<body data-page="onboarding" data-root="../../../../">
  <div class="qs" id="qs" data-step="meet">
    <svg class="qs-botanical qs-botanical-a" viewBox="0 0 220 260" aria-hidden="true"><path d="M30 250C40 170 70 110 130 60" fill="none" stroke="#7f9c6a" stroke-width="3" stroke-linecap="round"/><path d="M58 170c-30-6-44-26-40-50 26 2 42 22 40 50Z" fill="#c9dbb0" stroke="#7f9c6a" stroke-width="2.4"/><path d="M84 122c-6-30 8-52 34-58 6 26-8 48-34 58Z" fill="#d7e5c2" stroke="#7f9c6a" stroke-width="2.4"/><path d="M110 84c18-24 44-30 66-18-14 22-40 30-66 18Z" fill="#c9dbb0" stroke="#7f9c6a" stroke-width="2.4"/></svg>
    <svg class="qs-botanical qs-botanical-b" viewBox="0 0 240 200" aria-hidden="true"><path d="M230 190C170 170 120 130 90 70" fill="none" stroke="#7f9c6a" stroke-width="3" stroke-linecap="round"/><path d="M160 152c4-30 26-44 50-40-2 26-22 42-50 40Z" fill="#d7e5c2" stroke="#7f9c6a" stroke-width="2.4"/><path d="M118 110c-28-10-38-34-30-56 24 6 36 30 30 56Z" fill="#c9dbb0" stroke="#7f9c6a" stroke-width="2.4"/><circle cx="92" cy="64" r="9" fill="#f6d27a" stroke="#7f9c6a" stroke-width="2.4"/></svg>

    <header class="qs-top">
      <a class="qs-brand" href="../../../../index.html" aria-label="DeepSprout home"><svg viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="#1f3a2b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 36V20"/><path d="M20 22C10 22 5 16 5 7c9 0 15 5 15 15Z" fill="#a9c58c"/><path d="M20 19c0-9 6-14 15-14 0 9-6 14-15 14Z" fill="#a9c58c"/></svg><span>DeepSprout</span></a>
      <div class="qs-progress" id="qs-progress" aria-hidden="true">
        <p class="qs-progress-label"><span id="qs-count">Question 1 of 6</span><span class="qs-progress-saved" id="qs-saved"></span></p>
        <div class="qs-progress-track"><span class="qs-progress-fill" id="qs-fill"></span></div>
      </div>
    </header>

    <main class="qs-main" id="qs-main">
      <!-- Welcome: Meet Bimo -->
      <section class="qs-scene qs-meet" data-scene="meet" aria-labelledby="meet-title">
        <div class="qs-meet-copy">
          <p class="qs-eyebrow" id="meet-hello">Welcome to DeepSprout</p>
          <h1 class="qs-hand" id="meet-title">Hi, I’m Bimo.</h1>
          <p class="qs-lead">I’ll help you make a little more room for what matters. Six short questions, a short story, and you’re in.</p>
          <div class="qs-actions">
            <button class="qs-btn qs-btn-primary" type="button" id="meet-begin">Let’s Begin <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>
            <button class="qs-btn qs-btn-quiet" type="button" id="meet-skip">Skip the introduction</button>
          </div>
          <p class="qs-fine">About a minute. Your answers stay private and you can change them later.</p>
        </div>
        <figure class="qs-bimo">
          <span class="qs-bimo-halo" aria-hidden="true"></span>
          <img src="../../../../assets/hero-v2/bimo-awake.png" alt="Bimo, the DeepSprout guide" width="700" height="860">
        </figure>
      </section>

      <!-- Quick Setup: six questions, one at a time -->
      <section class="qs-scene qs-questions" data-scene="questions" hidden aria-labelledby="q-title">
        <form class="qs-form" id="qs-form" novalidate>
          <div class="qs-question" id="qs-question" aria-live="polite"></div>
          <p class="qs-error" id="qs-error" role="alert"></p>
          <div class="qs-nav">
            <button class="qs-btn qs-btn-quiet" type="button" id="qs-back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6"/></svg> Back</button>
            <button class="qs-btn qs-btn-primary" type="submit" id="qs-next">Continue <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>
          </div>
        </form>
      </section>

      <!-- The setup has ended; the story begins -->
      <section class="qs-scene qs-ready" data-scene="ready" hidden aria-labelledby="ready-title">
        <div class="qs-ready-copy">
          <h1 class="qs-hand" id="ready-title">You’re ready to begin.</h1>
          <p class="qs-ready-lead"><em>But first, let’s take a look at how easily our attention can drift — and how we can find our way back.</em></p>
          <div class="qs-actions qs-actions-center">
            <button class="qs-btn qs-btn-primary" type="button" id="ready-story">Explore the Story <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></button>
          </div>
          <div class="qs-returning" id="qs-returning" hidden>
            <a class="qs-btn qs-btn-quiet" href="../../../../index.html">Go to Home</a>
            <a class="qs-btn qs-btn-quiet" href="?step=setup">Change my answers</a>
          </div>
        </div>
      </section>
    </main>

    <!-- The horizon the story opens on: the same sun, rising as the setup ends. -->
    <div class="qs-horizon" aria-hidden="true">
      <svg viewBox="0 0 1600 300" preserveAspectRatio="xMidYMax slice">
        <circle class="qs-sun" cx="800" cy="250" r="58" fill="#f8d371"/>
        <path d="M-20 260C200 220 420 214 620 236C760 252 880 226 1040 218C1220 210 1400 232 1620 222V300H-20Z" fill="#e6ecd6"/>
        <path d="M-20 290C240 262 520 258 760 272C1000 286 1240 262 1620 270V300H-20Z" fill="#d6e2bf"/>
      </svg>
    </div>
  </div>
</body>
</html>
