@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f7ef"><title>Partner workspaces — DeepSprout</title>
  <link rel="icon" href="assets/brand/floral-mark.png">
  <link rel="stylesheet" href="src/styles/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="src/workspaces/workspaces.css">
  <link rel="stylesheet" href="src/workspaces/institution.css">
  <link rel="stylesheet" href="src/workspaces/institution-reports.css">
  <link rel="stylesheet" href="src/workspaces/student-initiative.css">
  <link rel="stylesheet" href="src/workspaces/coach-report.css">
  <link rel="stylesheet" href="src/workspaces/admin-owner.css">
  <link rel="stylesheet" href="src/workspaces/admin-console.css">
  <link rel="stylesheet" href="src/workspaces/supervisor-desk.css">
  <link rel="stylesheet" href="src/styles/initiative-portal.css">
  <script src="src/pages/member/lab/assessment-data.js"></script>
  <link rel="stylesheet" href="src/workspaces/journey/journey.css">
  <link rel="stylesheet" href="src/pages/auth/register/experience/experience.css">
  <link rel="stylesheet" href="~/src/workspaces/ds-system.css" asp-append-version="true">
  <script src="assets/vendor/qrcode/qrcode.js" defer></script>
  <script type="module" src="~/src/workspaces/app.js" asp-append-version="true"></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div id="app"></div>
  <div id="workspace-toast" class="toast" popover="manual" role="status" aria-live="polite"><span class="toast-icon" aria-hidden="true"></span><span class="toast-text"></span><button type="button" class="toast-close" aria-label="Dismiss message"></button></div>
  <dialog id="workspace-dialog" aria-labelledby="dialog-title">
    <form id="dialog-form"><div class="dialog-heading"><div><p class="eyebrow">DEEPSPROUT</p><h2 id="dialog-title"></h2></div><button type="button" class="icon-button" data-dialog-close aria-label="Close dialog">×</button></div><div id="dialog-body"></div><p id="dialog-error" class="error" role="alert"></p><div class="dialog-actions"><button type="button" class="button quiet" data-dialog-close>Cancel</button><button class="button primary" id="dialog-save">Save</button></div></form>
  </dialog>
</body>
</html>
