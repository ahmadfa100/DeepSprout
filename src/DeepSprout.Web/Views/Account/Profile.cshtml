@model DeepSprout.Web.Account.ProfileViewModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fffefa">
  <title>Account security — DeepSprout</title>
  <link rel="icon" type="image/png" href="/assets/brand/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { margin:0; min-height:100vh; display:grid; place-items:center; padding:24px; box-sizing:border-box; background:#f7f8f2; color:#173c33; font:16px/1.5 'DM Sans',sans-serif; }
    main { width:min(100%,440px); padding:36px; box-sizing:border-box; border:1px solid #dfe8dc; border-radius:22px; background:#fffefa; }
    img { width:52px; height:52px; object-fit:contain; }
    h1 { margin:18px 0 8px; font-size:30px; line-height:1.2; }
    p { margin:0 0 24px; color:#596b62; }
    dl { margin:0 0 26px; } dt { color:#596b62; font-size:13px; } dd { margin:2px 0 16px; font-weight:600; overflow-wrap:anywhere; }
    a,button { display:inline-block; border-radius:12px; padding:12px 18px; font:600 15px 'DM Sans',sans-serif; }
    a { background:#123f34; color:white; text-decoration:none; }
    button { border:1px solid #b9cec0; background:transparent; color:#123f34; cursor:pointer; }
    a:focus-visible,button:focus-visible { outline:3px solid #168557; outline-offset:3px; }
    .actions { display:flex; flex-wrap:wrap; gap:10px; }
  </style>
</head>
<body>
  <main>
    <img src="/assets/brand/floral-mark.png" alt="">
    <h1>Account security</h1>
    <p>Your signed-in DeepSprout account.</p>
    <dl><dt>Name</dt><dd>@Model.DisplayName</dd><dt>Email</dt><dd>@Model.Email</dd></dl>
    <div class="actions">
      <a href="/src/pages/member/dashboard/dashboard.html">Continue to DeepSprout</a>
      <form method="post" action="/account/logout">@Html.AntiForgeryToken()<button type="submit">Log out</button></form>
    </div>
  </main>
</body>
</html>
